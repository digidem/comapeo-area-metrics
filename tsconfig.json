{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleDetection": "force",
		"types": ["node"],

		// Node runs src/ and test/ directly by stripping types, so only
		// erasable syntax and explicit .ts import specifiers are allowed
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		// For the plain-JS fixtures under test/; they are not type-checked
		"allowJs": true,
		"noEmit": true
	},
	"include": ["src", "test", "bench"]
}
